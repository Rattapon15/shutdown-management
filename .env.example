# Copy to .env and fill in. Never commit the real .env.
# On Cloud Run set these as environment variables, with DB_PASSWORD from Secret Manager.

# ── PostgreSQL (Azure Database for PostgreSQL) ────────────────────────────────
DB_USER=aiproject
DB_PASSWORD=
DB_HOST=rms-scgp-dwh-prd.postgres.database.azure.com
DB_PORT=5432
DB_NAME=rms-scgp-dwh

# This project's schema on the shared database. Tables are prefixed shutdown_mnm_.
DB_SCHEMA=ai_project

# Azure PostgreSQL requires TLS. "require" encrypts the connection; use
# "verify-full" (with DB_CA_CERT) to also validate the server certificate.
DB_SSL_MODE=require
# DB_CA_CERT=

# Max pooled connections per instance. Cloud Run runs many instances against the
# same database, so keep this low.
DB_POOL_MAX=5

# ── Server ────────────────────────────────────────────────────────────────────
# Cloud Run injects PORT; locally it defaults to 3000.
# PORT=3000
# HOST=0.0.0.0

# Set to "production" on Cloud Run — adds the Secure flag to session cookies.
NODE_ENV=development

# Login session lifetime in hours.
SESSION_TTL_HOURS=12

# ── Authentication ────────────────────────────────────────────────────────────
# Signs the session and sign-in cookies. Must be STABLE (same value across
# restarts) and IDENTICAL on every Cloud Run instance, or users get logged out /
# logins fail when a request lands on a different instance. Required in
# production (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# On Cloud Run, supply it from Secret Manager.
SESSION_SECRET=

# Username/password sign-in is OFF by default (everyone uses Microsoft). Set to
# "true" to re-enable the password form and local-user creation.
# ALLOW_LOCAL_LOGIN=false

# Microsoft Entra ID (SPA, auth-code + PKCE, no client secret). These default to
# this app's registration; override only for another tenant / app.
# The registered redirect URI must be exactly <origin>/oauth2/callback, as a
# "Single-page application" platform.
# ENTRA_TENANT_ID=5db8bf0e-8592-4ed0-82b2-a6d4d77933d4
# ENTRA_CLIENT_ID=824220ec-ee74-465f-8b44-0e2c5e931506

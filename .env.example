# Copy to .env and fill in. Never commit the real .env.
# On Cloud Run set these as environment variables, with DB_PASSWORD from Secret Manager.

# ── PostgreSQL (Azure Database for PostgreSQL) ────────────────────────────────
DB_USER=aiproject
DB_PASSWORD=
DB_HOST=rms-scgp-dwh-prd.postgres.database.azure.com
DB_PORT=5432
DB_NAME=rms-scgp-dwh

# This project's schema on the shared database. Tables are prefixed shutdown_mnm_.
DB_SCHEMA=ai_project

# Azure PostgreSQL requires TLS. "require" encrypts the connection; use
# "verify-full" (with DB_CA_CERT) to also validate the server certificate.
DB_SSL_MODE=require
# DB_CA_CERT=

# Max pooled connections per instance. Cloud Run runs many instances against the
# same database, so keep this low.
DB_POOL_MAX=5

# ── Server ────────────────────────────────────────────────────────────────────
# Cloud Run injects PORT; locally it defaults to 3000.
# PORT=3000
# HOST=0.0.0.0

# Set to "production" on Cloud Run — adds the Secure flag to session cookies.
NODE_ENV=development

# Login session lifetime in hours.
SESSION_TTL_HOURS=12

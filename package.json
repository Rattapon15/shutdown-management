{
  "name": "shutdown-management",
  "version": "1.0.0",
  "description": "Plant Shutdown Management Dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "migrate": "node migrate.js",
    "migrate:schema": "node migrate.js --schema-only",
    "migrate:reset": "node migrate.js --reset",
    "docker:build": "docker build -t shutdown-management .",
    "docker:run": "docker run --rm -p 8080:8080 --env-file .env -e PORT=8080 shutdown-management"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^4.18.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0",
    "xlsx": "^0.18.5"
  }
}

{
  "name": "shutdown-management",
  "version": "1.0.0",
  "description": "Plant Shutdown Management Dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "npm run build && node server.js",
    "migrate": "node migrate.js",
    "migrate:schema": "node migrate.js --schema-only",
    "migrate:reset": "node migrate.js --reset",
    "docker:build": "docker build -t shutdown-management .",
    "docker:run": "docker run --rm -p 8080:8080 --env-file .env -e PORT=8080 shutdown-management",
    "build": "esbuild src/auth.ts --bundle --minify --format=iife --target=es2020 --sourcemap --outfile=public/auth.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.25.0",
    "dotenv": "^18.0.4",
    "express": "^4.18.3",
    "jose": "^6.2.12",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
